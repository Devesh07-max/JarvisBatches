# Public URL, e.g. https://jarvisbatches.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=
MONGODB_DB=jarvis_batches

# Razorpay Test keys first; switch to Live only after complete testing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Telegram bot token from @BotFather; keep it secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-secret

# Admin panel login: use a strong, unique password
ADMIN_PASSWORD=
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional: Cloudinary image upload for course thumbnails
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
